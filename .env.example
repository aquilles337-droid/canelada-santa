# ============================================================
# Canelada Santa — variaveis de ambiente
# Copie para .env.local (desenvolvimento) ou .env (servidor) e preencha.
# O README explica, passo a passo, onde pegar cada uma destas chaves.
# NUNCA versione o arquivo preenchido.
# ============================================================

# ------------------------------------------------------------
# Supabase — painel do projeto > Project Settings > API Keys
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-aqui-a-chave-publica-anon"
# Chave secreta (service_role). So no servidor. Ela ignora todas as regras
# de seguranca do banco — nunca coloque em codigo que vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY="cole-aqui-a-chave-service-role"

# ------------------------------------------------------------
# Aplicacao
# ------------------------------------------------------------
# Endereco publico do aplicativo. Precisa bater com o dominio real em
# producao: e usado nos links das notificacoes e no retorno do pagamento.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Dominio do e-mail sintetico usado internamente pelo login por telefone.
# Nao precisa existir de verdade; so nao mude depois que o grupo se cadastrar.
NEXT_PUBLIC_PHONE_EMAIL_DOMAIN="telefone.canelada.app"

# ------------------------------------------------------------
# Pagamentos
# ------------------------------------------------------------
# "mock" = ambiente de desenvolvimento, gera PIX de mentira e nao cobra
# ninguem. "mercadopago" = producao, exige MP_ACCESS_TOKEN.
PAYMENT_PROVIDER="mock"
# Mercado Pago > Suas integracoes > sua aplicacao > Credenciais de producao
MP_ACCESS_TOKEN=""
# Mercado Pago > Suas integracoes > sua aplicacao > Webhooks > assinatura secreta
MP_WEBHOOK_SECRET=""
# Minutos ate o PIX expirar
MP_PIX_EXPIRATION_MINUTES="30"

# ------------------------------------------------------------
# Notificacoes (Web Push) — gere com: npm run gen:vapid
# ------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:contato@caneladasanta.app"

# ------------------------------------------------------------
# Tarefas agendadas
# ------------------------------------------------------------
# Segredo que o cron do servidor envia no cabecalho x-cron-secret.
# Gere com: openssl rand -hex 32
CRON_SECRET=""
